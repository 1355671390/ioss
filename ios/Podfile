platform :ios, '13.0'

target 'Runner' do
  # 强制使用静态链接，彻底绕开模块化报错
  use_frameworks! :linkage => :static

  # 1. 核心：直接手动引入 Peertalk，不依赖 Flutter 脚本
  pod 'peertalk', :git => 'https://github.com/rsms/peertalk.git'

  # 2. 如果你有其他 Flutter 插件，这一行会尝试安装它们（如果失败会自动跳过）
  begin
    setup_path = File.expand_path(File.join('..', '..', 'packages', 'flutter_tools', 'bin', 'podhelper'), __dir__)
    if File.exist?(setup_path)
      require setup_path
      flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
    end
  rescue => e
    puts "忽略 Flutter 插件自动化安装: #{e.message}"
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['CODE_SIGNING_REQUIRED'] = "NO"
      config.build_settings['CODE_SIGNING_ALLOWED'] = "NO"
      # 注入头文件搜索路径，确保桥接文件能看到 PTChannel.h
      config.build_settings['HEADER_SEARCH_PATHS'] = '$(inherited) ${PODS_ROOT}/Headers/Public/peertalk'
    end
  end
end
